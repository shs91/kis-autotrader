# KIS API
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=your_account_number
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_ENV=virtual

# ── 멀티마켓 (미국 주식 확장) ──
# MARKET=KRX                         # 프로세스별 시장: KRX(국내, 기본) | US(미국 야간 정규장).
#                                    #   국내 프로세스는 미설정(KRX), 미국 야간 프로세스는 MARKET=US로 기동.
# 미국(US) 자격증명 — MARKET=US일 때 KIS_US_* 를 사용(실전 계좌). KIS_ENV는 US 프로파일이 real로 내장.
# KIS_US_APP_KEY=your_us_app_key
# KIS_US_APP_SECRET=your_us_app_secret
# KIS_US_ACCOUNT_NO=your_us_account_number
# KIS_US_ACCOUNT_PRODUCT_CODE=01
# 미국 관심종목 — "심볼:거래소" 형식(거래소=NASD|NYSE|AMEX). 고정 유니버스(동적 스크리닝은 후속).
# WATCHLIST_CODES_US=AAPL:NASD,MSFT:NASD,KO:NYSE
# US_CASH_BUDGET=1000                # 미국 사이클 매수 예산(USD). 실매수량은 브로커 매수가능수량으로 캡.
# 미국 보수 한도(P4) — 야간 무인 실전 안전. 기본값이 KRX보다 보수적.
# US_MAX_POSITION_RATIO=0.1          # 단일 포지션 최대 비율(기본 10%)
# US_DAILY_TRADE_LIMIT=5             # 일일 총 매매 횟수(기본 5)
# US_MAX_LOSS_RATE=0.03              # 개별 종목 손절률(기본 3%)
# US_MAX_DAILY_TRADES_PER_STOCK=1    # 종목당 당일 진입 횟수(기본 1)
# SCREENING_MIN_PRICE_US=1           # 미국 매수 하드 가격 플로어(USD, 기본 $1)
# US_PRESENT_BALANCE_ENABLED=true    # 외화예수금·총손익·고시환율 조회(CTRP6504R). 오작동 시 false→보수 폴백.
# FX_USD_KRW=1380                    # present-balance 환율 조회 실패 시 폴백 환율(표시/원화 환산용).
# HEALTH_PORT=18924                  # 미국 프로세스 헬스체크 포트(국내 18923과 분리). launchd US plist에서 설정.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kis_trader

# Google Calendar
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_CREDENTIALS_PATH=credentials.json

# Rate Limit
API_RATE_LIMIT_PER_SECOND=3
API_DAILY_CALL_LIMIT=10000
WS_MAX_RECONNECT_ATTEMPTS=5
WS_RECONNECT_BASE_DELAY=5

# Trading
MAX_LOSS_RATE=0.03
MAX_POSITION_RATIO=0.2
DAILY_TRADE_LIMIT=10
MAX_DAILY_TRADES_PER_STOCK=2       # 종목별 당일 최대 진입(매수) 횟수 (1~5 권장, 매도는 무제한)
# TRADING_MIN_INTERVAL_SECONDS=10  # 장중 매매 사이클 최소 간격(초). 종목 미확정(스크리닝 의존)/소수 종목 시 1초 폭주(일일 API 한도 조기 소진·KIS EGW00201 초당한도 거부) 방지. 기본 10
# NEWS_RISK_GATE_ENABLED=true      # 공시 기반 매수 차단 게이트 (상장폐지/정리매매 등 치명 공시 종목 매수 차단)
# NEWS_RISK_LOOKBACK_DAYS=30       # 치명 공시 조회 기간(일)
# SIGNAL_REVERSAL_WINDOW_SECONDS=600 # 단기 신호 반전 관측 윈도(초) — 동일 종목 BUY↔SELL 반전을 SIGNAL_REVERSAL 메트릭으로 계량(관측 전용)

# Safety (실전 안전장치)
# KIS_TRADING_HALT_FILE=.trading_halt  # 이 파일을 touch하면 매매 즉시 동결, rm하면 재개(런타임 비상정지). 기본 .trading_halt
# DB_PRECHECK_BEFORE_ORDER=true        # 주문 직전 DB 헬스체크(SELECT 1), 실패 시 주문 보류. 기본: 실전(real)=true, 모의=false
# RECONCILE_ORPHAN_FILLS=true          # 미체결 취소 직전 잔고 재확인으로 지연 체결 회수(추적 불가 포지션 방지). 기본 true

# Portfolio Risk
# MAX_DAILY_DRAWDOWN=0.05
# MAX_CONSECUTIVE_LOSSES=5
# MAX_DAILY_LOSS_ABS=0            # 일일 절대 손실 하한(통화 절대금액, 0=비활성; MDD와 별개로 이익 피크 없는 날도 발동)
# MARKET_CLOSE_LOSS_CUT_RATE=0    # 마감 손실 컷(0=비활성; 마감 임박 시 -x% 이하 깊은 손실 강제 청산, 오버나잇 갭 방지)
# MARKET_CLOSE_CUTOFF_HOUR=14
# MARKET_CLOSE_CUTOFF_MINUTE=30

# Strategy
# STRATEGY_DEFAULT=moving_average
# STRATEGY_MAPPINGS=005930:rsi,000660:moving_average
# STRATEGY_MA_SHORT_PERIOD=5
# STRATEGY_MA_LONG_PERIOD=20
# STRATEGY_MA_MAX_DIVERGENCE=0.05
# STRATEGY_RSI_PERIOD=14
# STRATEGY_RSI_OVERSOLD=30.0
# STRATEGY_RSI_OVERBOUGHT=70.0
# STRATEGY_ENSEMBLE_METHOD=weighted
# TAKE_PROFIT_RATIO=0.05
# STRATEGY_MIN_CONFIDENCE=0.1

# Screening (종목 스크리닝)
# SCREENING_TOP_N=30
# SCREENING_INTERVAL_CYCLES=30
# MAX_SCREENED_STOCKS=10
# SCREENING_MIN_PRICE=1000
# SCREENING_MAX_PRICE=300000
# SCREENING_MIN_MARKET_CAP=50000000
# SCREENING_CHANGE_RATE_MIN=-3.0
# SCREENING_CHANGE_RATE_MAX=15.0
# SCREENING_MIN_VOLUME=50000
# SCREENING_WEIGHT_VOLUME_RANK=0.2
# SCREENING_WEIGHT_CHANGE_RATE=0.3
# SCREENING_WEIGHT_STRATEGY=0.5
# SCREENING_MIN_SCORE=0.25

# Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_ENABLED=false

# Redis
# REDIS_URL=redis://localhost:6379/0

# Worker
# WORKER_ENABLED=true
# WORKER_POLL_INTERVAL=15       # 기본값 30s는 매매 사이클(10s) 대비 느려 큐 적체 유발
# WORKER_MAX_RETRIES=5
# WORKER_RETRY_BASE_DELAY=60
# WORKER_BATCH_SIZE=50          # 기본값 10건/30s = 20건/분 처리. 매매 사이클당 ~10건
#                               # 메트릭 enqueue되므로 50/15s = 200건/분 권장.

# Docker PostgreSQL (docker-compose 전용)
POSTGRES_DB=kis_trader
POSTGRES_USER=kis
POSTGRES_PASSWORD=change_me_to_strong_password

# 포트 커스텀 (선택)
# DB_PORT=5432
# HEALTH_PORT=18923
# DASHBOARD_PORT=8501

# News Collector (데이터 수집 파이프라인 — docs/plans/2026-05-18_data-collection-pipeline.md)
# DART OpenAPI (https://opendart.fss.or.kr/) — 일 20,000건 한도
NEWS_DART_API_KEY=
# NEWS_DART_CORP_CODE_PATH=data/dart/corp_code.xml
# NEWS_DART_RATE_LIMIT_PER_SEC=1.0
# RSS 피드 설정 — config/rss_feeds.example.json 복사 후 편집
# (label/category/provider/url 구조. cp config/rss_feeds.example.json config/rss_feeds.json)
# NEWS_RSS_CONFIG_PATH=config/rss_feeds.json
# NEWS_RSS_USER_AGENT=kis-autotrader/0.1 (+contact: 운영자)
# Embedding (BGE-M3 — 1024-dim dense)
# NEWS_EMBEDDING_MODEL=BAAI/bge-m3
# NEWS_EMBEDDING_BATCH_SIZE=12
# NEWS_EMBEDDING_MAX_TOKENS=8192
# Pipeline
# NEWS_COLLECT_INTERVAL_MIN=5
# NEWS_CHUNK_RETENTION_DAYS=90

# pykrx 인증 (KRX 정보데이터시스템 — https://data.krx.co.kr/ 무료 계정)
# 공매도/투자자별 매매 API 호출에 필수 (KRX 정책 변경으로 인증 요구)
# KRX_ID=
# KRX_PW=
